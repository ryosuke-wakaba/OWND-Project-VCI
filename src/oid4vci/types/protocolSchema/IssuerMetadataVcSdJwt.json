{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "additionalProperties": false,
    "definitions": {
        "BaseLogo": {
            "additionalProperties": true,
            "properties": {
                "alt_text": {
                    "type": "string"
                },
                "uri": {
                    "type": "string"
                }
            },
            "required": [
                "uri"
            ],
            "type": "object"
        },
        "ClaimDisplay": {
            "additionalProperties": true,
            "properties": {
                "locale": {
                    "type": "string"
                },
                "name": {
                    "type": "string"
                }
            },
            "type": "object"
        },
        "ClaimMetadata": {
            "additionalProperties": false,
            "description": "Claim metadata for SD-JWT VC format (OID4VCI v1.0 compliant array format)\nhttps://openid.net/specs/openid-4-verifiable-credential-issuance-1_0.html#name-credential-issuer-metadata-p",
            "properties": {
                "display": {
                    "description": "Array of objects containing localized display information",
                    "items": {
                        "$ref": "#/definitions/ClaimDisplay"
                    },
                    "type": "array"
                },
                "mandatory": {
                    "description": "When true, indicates the claim must be included in issued credentials",
                    "type": "boolean"
                },
                "path": {
                    "description": "Non-empty array serving as a claims path pointer identifying the specific claim",
                    "items": {
                        "type": "string"
                    },
                    "type": "array"
                },
                "value_type": {
                    "description": "Data type of the claim value (e.g., \"string\", \"number\", \"boolean\")",
                    "type": "string"
                }
            },
            "required": [
                "path"
            ],
            "type": "object"
        },
        "CredentialDisplay": {
            "additionalProperties": true,
            "properties": {
                "background_color": {
                    "type": "string"
                },
                "background_image": {
                    "additionalProperties": false,
                    "properties": {
                        "uri": {
                            "type": "string"
                        }
                    },
                    "required": [
                        "uri"
                    ],
                    "type": "object"
                },
                "description": {
                    "type": "string"
                },
                "locale": {
                    "type": "string"
                },
                "logo": {
                    "$ref": "#/definitions/BaseLogo",
                    "additionalProperties": true
                },
                "name": {
                    "type": "string"
                },
                "text_color": {
                    "type": "string"
                }
            },
            "type": "object"
        },
        "CredentialMetadataContent": {
            "additionalProperties": false,
            "description": "Credential metadata content for SD-JWT VC format\nContains claims array and optional credential-level display",
            "properties": {
                "claims": {
                    "description": "Array of claim metadata objects",
                    "items": {
                        "$ref": "#/definitions/ClaimMetadata"
                    },
                    "type": "array"
                },
                "display": {
                    "description": "Credential-level display information",
                    "items": {
                        "$ref": "#/definitions/CredentialDisplay"
                    },
                    "type": "array"
                }
            },
            "type": "object"
        },
        "CredentialResponseEncryption": {
            "additionalProperties": false,
            "properties": {
                "alg_values_supported": {
                    "items": {
                        "type": "string"
                    },
                    "type": "array"
                },
                "enc_values_supported": {
                    "items": {
                        "type": "string"
                    },
                    "type": "array"
                },
                "encryption_required": {
                    "type": "boolean"
                }
            },
            "required": [
                "alg_values_supported",
                "enc_values_supported",
                "encryption_required"
            ],
            "type": "object"
        },
        "IssuerDisplay": {
            "additionalProperties": true,
            "properties": {
                "background_color": {
                    "type": "string"
                },
                "locale": {
                    "type": "string"
                },
                "logo": {
                    "$ref": "#/definitions/BaseLogo",
                    "additionalProperties": true
                },
                "name": {
                    "type": "string"
                },
                "text_color": {
                    "type": "string"
                }
            },
            "type": "object"
        }
    },
    "properties": {
        "authorization_servers": {
            "items": {
                "type": "string"
            },
            "type": "array"
        },
        "batch_credential_endpoint": {
            "type": "string"
        },
        "credential_configurations_supported": {
            "additionalProperties": {
                "additionalProperties": false,
                "properties": {
                    "credential_metadata": {
                        "$ref": "#/definitions/CredentialMetadataContent"
                    },
                    "credential_signing_alg_values_supported": {
                        "items": {
                            "type": "string"
                        },
                        "type": "array"
                    },
                    "cryptographic_binding_methods_supported": {
                        "items": {
                            "type": "string"
                        },
                        "type": "array"
                    },
                    "format": {
                        "type": "string"
                    },
                    "order": {
                        "items": {
                            "type": "string"
                        },
                        "type": "array"
                    },
                    "proof_types_supported": {
                        "additionalProperties": {
                            "additionalProperties": false,
                            "properties": {
                                "proof_signing_alg_values_supported": {
                                    "items": {
                                        "type": "string"
                                    },
                                    "type": "array"
                                }
                            },
                            "required": [
                                "proof_signing_alg_values_supported"
                            ],
                            "type": "object"
                        },
                        "type": "object"
                    },
                    "scope": {
                        "type": "string"
                    },
                    "vct": {
                        "type": "string"
                    }
                },
                "required": [
                    "credential_metadata",
                    "credential_signing_alg_values_supported",
                    "cryptographic_binding_methods_supported",
                    "format",
                    "vct"
                ],
                "type": "object"
            },
            "type": "object"
        },
        "credential_endpoint": {
            "type": "string"
        },
        "credential_identifiers_supported": {
            "type": "boolean"
        },
        "credential_issuer": {
            "type": "string"
        },
        "credential_response_encryption": {
            "$ref": "#/definitions/CredentialResponseEncryption"
        },
        "deferred_credential_endpoint": {
            "type": "string"
        },
        "display": {
            "items": {
                "$ref": "#/definitions/IssuerDisplay"
            },
            "type": "array"
        },
        "nonce_endpoint": {
            "type": "string"
        },
        "notification_endpoint": {
            "type": "string"
        },
        "signed_metadata": {
            "type": "string"
        }
    },
    "required": [
        "credential_configurations_supported",
        "credential_endpoint",
        "credential_issuer"
    ],
    "type": "object"
}

