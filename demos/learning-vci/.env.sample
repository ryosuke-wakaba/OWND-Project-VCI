# Application
APP_PORT=3002
DATABASE_FILEPATH=./data/learning-vci.db

# Basic Auth for Admin
BASIC_AUTH_USERNAME=admin
BASIC_AUTH_PASSWORD=admin

# VCI Configuration
CREDENTIAL_ISSUER=http://localhost:3002
CREDENTIAL_ISSUER_IDENTIFIER=http://localhost:3002

# Token/Code Expiration (in seconds)
VCI_PRE_AUTH_CODE_EXPIRES_IN=86400
VCI_ACCESS_TOKEN_EXPIRES_IN=86400
VCI_ACCESS_TOKEN_C_NONCE_EXPIRES_IN=86400

# Issuer Display
ISSUER_NAME_JA=教育機関
ISSUER_NAME_EN=Educational Institution
BRAND_COLOR=#1E3A5F
