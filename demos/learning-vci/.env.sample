# Application
APP_PORT=3002
# For production, use a persistent path like /var/lib/ownd-vci/learning-vci.db
# to prevent data loss during deployments
DATABASE_FILEPATH=./data/learning-vci.db

# Basic Auth for Admin
BASIC_AUTH_USERNAME=admin
BASIC_AUTH_PASSWORD=admin

# VCI Configuration
CREDENTIAL_ISSUER=http://localhost:3002
CREDENTIAL_ISSUER_IDENTIFIER=http://localhost:3002

# Token/Code Expiration (in seconds)
VCI_PRE_AUTH_CODE_EXPIRES_IN=86400
VCI_ACCESS_TOKEN_EXPIRES_IN=86400
VCI_ACCESS_TOKEN_C_NONCE_EXPIRES_IN=86400

# Issuer Display
ISSUER_NAME_JA=教育機関
ISSUER_NAME_EN=Educational Institution
BRAND_COLOR=#1E3A5F

# DPoP Configuration (RFC9449)
# Set to "true" to enable DPoP support
DPOP_ENABLED=false
# Set to "true" to require DPoP for all requests (default: false)
DPOP_REQUIRED=false
