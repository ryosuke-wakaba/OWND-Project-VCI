<h2>キーペア生成</h2>

<form action="/admin/keys/new" method="POST" class="form-card">
  <div class="form-group">
    <label for="kid">キーID <span class="required">*</span></label>
    <input type="text" id="kid" name="kid" required placeholder="例: issuer-key-1">
    <small class="form-text">一意の識別子を入力してください</small>
  </div>

  <div class="form-group">
    <label for="curve">楕円曲線 <span class="required">*</span></label>
    <select id="curve" name="curve" required>
      <option value="P-256" selected>P-256 (NIST)</option>
      <option value="secp256k1">secp256k1 (Bitcoin/Ethereum)</option>
    </select>
    <small class="form-text">署名に使用する楕円曲線を選択してください</small>
  </div>

  <div class="form-actions">
    <a href="/admin/keys" class="btn btn-secondary">キャンセル</a>
    <button type="submit" class="btn btn-primary">生成</button>
  </div>
</form>

