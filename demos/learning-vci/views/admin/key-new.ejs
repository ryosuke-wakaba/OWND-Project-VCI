<nav class="breadcrumb">
  <a href="/admin"><%= t('common:breadcrumb.top') %></a> &gt; <a href="/admin/keys"><%= t('keys:breadcrumb.management') %></a> &gt; <span><%= t('keys:breadcrumb.new') %></span>
</nav>

<h2><%= t('keys:new.title') %></h2>

<form action="/admin/keys/new" method="POST" class="form-card">
  <div class="form-group">
    <label for="kid"><%= t('keys:form.keyId') %> <span class="required">*</span></label>
    <input type="text" id="kid" name="kid" required placeholder="<%= t('keys:form.keyIdPlaceholder') %>">
    <small class="form-text"><%= t('keys:form.keyIdHelp') %></small>
  </div>

  <div class="form-group">
    <label for="curve"><%= t('keys:form.curve') %> <span class="required">*</span></label>
    <select id="curve" name="curve" required>
      <option value="P-256" selected><%= t('keys:form.curveP256') %></option>
      <option value="secp256k1"><%= t('keys:form.curveSecp256k1') %></option>
    </select>
    <small class="form-text"><%= t('keys:form.curveHelp') %></small>
  </div>

  <div class="form-actions">
    <a href="/admin/keys" class="btn btn-secondary"><%= t('common:buttons.cancel') %></a>
    <button type="submit" class="btn btn-primary"><%= t('common:buttons.generate') %></button>
  </div>
</form>

<style>
.form-card {
  background: #f8f9fa;
  border-radius: 8px;
  padding: 1.5rem;
  max-width: 500px;
}
.form-group {
  margin-bottom: 1rem;
}
.form-group label {
  display: block;
  margin-bottom: 0.5rem;
  font-weight: 500;
}
.form-group input,
.form-group select {
  width: 100%;
  padding: 0.5rem;
  border: 1px solid #ced4da;
  border-radius: 4px;
  font-size: 1rem;
}
.form-group input:focus,
.form-group select:focus {
  outline: none;
  border-color: #80bdff;
  box-shadow: 0 0 0 0.2rem rgba(0,123,255,.25);
}
.form-text {
  display: block;
  margin-top: 0.25rem;
  font-size: 0.85em;
  color: #6c757d;
}
.required {
  color: #dc3545;
}
.form-actions {
  margin-top: 1.5rem;
  display: flex;
  gap: 0.5rem;
  justify-content: flex-end;
}
</style>
