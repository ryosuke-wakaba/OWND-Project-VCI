<nav class="breadcrumb">
  <a href="/admin"><%= t('common:breadcrumb.top') %></a> &gt; <a href="/admin/learners"><%= t('learners:breadcrumb.management') %></a> &gt; <span><%= t('learners:breadcrumb.new') %></span>
</nav>

<h2><%= t('learners:new.title') %></h2>

<div class="form-container">
  <form action="/admin/learners/new" method="POST">
    <div class="form-group">
      <label for="learnerNo"><%= t('learners:form.learnerNo') %> *</label>
      <input type="text" id="learnerNo" name="learner[learnerNo]" required>
    </div>

    <div class="form-group">
      <label for="familyName"><%= t('learners:form.familyName') %> *</label>
      <input type="text" id="familyName" name="learner[familyName]" required>
    </div>

    <div class="form-group">
      <label for="givenName"><%= t('learners:form.givenName') %></label>
      <input type="text" id="givenName" name="learner[givenName]">
    </div>

    <div class="form-group">
      <label for="issuingAuthority"><%= t('learners:form.issuingAuthority') %> *</label>
      <input type="text" id="issuingAuthority" name="learner[issuingAuthority]" required>
    </div>

    <div class="form-group">
      <label for="issuingCountry"><%= t('learners:form.issuingCountry') %> *</label>
      <input type="text" id="issuingCountry" name="learner[issuingCountry]" value="JP" required>
    </div>

    <div class="form-group">
      <label for="achievementTitle"><%= t('learners:form.achievementTitle') %> *</label>
      <input type="text" id="achievementTitle" name="learner[achievementTitle]" required>
    </div>

    <div class="form-group">
      <label for="achievementDescription"><%= t('learners:form.achievementDescription') %> *</label>
      <textarea id="achievementDescription" name="learner[achievementDescription]" rows="3" required></textarea>
    </div>

    <div class="form-group">
      <label for="learningOutcomes"><%= t('learners:form.learningOutcomes') %> *</label>
      <textarea id="learningOutcomes" name="learner[learningOutcomes]" rows="3" placeholder="<%= t('learners:form.learningOutcomesPlaceholder') %>" required></textarea>
    </div>

    <div class="form-group">
      <label for="assessmentGrade"><%= t('learners:form.assessmentGrade') %> *</label>
      <input type="text" id="assessmentGrade" name="learner[assessmentGrade]" placeholder="<%= t('learners:form.assessmentGradePlaceholder') %>" required>
    </div>

    <div class="form-group">
      <label for="dateOfIssuance"><%= t('learners:form.dateOfIssuance') %> *</label>
      <input type="date" id="dateOfIssuance" name="learner[dateOfIssuance]" required>
    </div>

    <div class="form-group">
      <label for="dateOfExpiry"><%= t('learners:form.dateOfExpiry') %> *</label>
      <input type="date" id="dateOfExpiry" name="learner[dateOfExpiry]" required>
    </div>

    <div class="form-group">
      <label><%= t('learners:form.languageOfClasses') %> *</label>
      <div class="checkbox-group">
        <label class="checkbox-label">
          <input type="checkbox" name="learner[languageOfClasses][]" value="ja" checked> Japanese (ja)
        </label>
        <label class="checkbox-label">
          <input type="checkbox" name="learner[languageOfClasses][]" value="en"> English (en)
        </label>
      </div>
    </div>

    <div class="form-group">
      <label for="expectedStudyTime"><%= t('learners:form.expectedStudyTime') %> *</label>
      <input type="text" id="expectedStudyTime" name="learner[expectedStudyTime]" placeholder="<%= t('learners:form.expectedStudyTimePlaceholder') %>" required>
    </div>

    <div class="form-group">
      <label for="levelOfLearningExperience"><%= t('learners:form.levelOfLearningExperience') %> *</label>
      <select id="levelOfLearningExperience" name="learner[levelOfLearningExperience]" required>
        <option value="1">1 - Basic</option>
        <option value="2">2</option>
        <option value="3">3</option>
        <option value="4">4</option>
        <option value="5">5</option>
        <option value="6">6</option>
        <option value="7">7</option>
        <option value="8">8 - Advanced</option>
      </select>
      <small class="form-hint"><%= t('learners:form.levelOfLearningExperienceHint') %></small>
    </div>

    <div class="form-group">
      <label for="typesOfQualityAssurance"><%= t('learners:form.typesOfQualityAssurance') %> *</label>
      <textarea id="typesOfQualityAssurance" name="learner[typesOfQualityAssurance]" rows="2" placeholder="<%= t('learners:form.typesOfQualityAssurancePlaceholder') %>" required></textarea>
    </div>

    <div class="form-group">
      <label for="prerequisitesToEnroll"><%= t('learners:form.prerequisitesToEnroll') %></label>
      <textarea id="prerequisitesToEnroll" name="learner[prerequisitesToEnroll]" rows="2" placeholder="<%= t('learners:form.prerequisitesToEnrollPlaceholder') %>"></textarea>
    </div>

    <div class="form-group">
      <label class="checkbox-label">
        <input type="checkbox" name="learner[integrationStackabilityOptions]" value="true">
        <%= t('learners:form.integrationStackabilityOptions') %>
      </label>
      <small class="form-hint"><%= t('learners:form.integrationStackabilityOptionsHint') %></small>
    </div>

    <div class="form-actions">
      <button type="submit" class="btn btn-primary"><%= t('common:buttons.register') %></button>
      <a href="/admin/learners" class="btn btn-secondary"><%= t('common:buttons.cancel') %></a>
    </div>
  </form>
</div>
