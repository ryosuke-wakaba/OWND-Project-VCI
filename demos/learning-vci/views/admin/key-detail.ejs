<nav class="breadcrumb">
  <a href="/admin">トップ</a> &gt; <a href="/admin/keys">キーペア管理</a> &gt; <span>詳細</span>
</nav>

<h2>キーペア詳細</h2>

<div class="detail-card">
  <h3>基本情報</h3>
  <table class="detail-table">
    <tr>
      <th>キーID</th>
      <td><%= key.kid %></td>
    </tr>
    <tr>
      <th>鍵タイプ</th>
      <td><%= key.kty %></td>
    </tr>
    <tr>
      <th>楕円曲線</th>
      <td><%= key.crv %></td>
    </tr>
    <tr>
      <th>作成日</th>
      <td><%= new Date(key.createdAt).toLocaleString('ja-JP') %></td>
    </tr>
    <tr>
      <th>状態</th>
      <td>
        <% if (key.revokedAt) { %>
          <span class="badge badge-danger">失効 (<%= new Date(key.revokedAt).toLocaleString('ja-JP') %>)</span>
        <% } else { %>
          <span class="badge badge-success">有効</span>
        <% } %>
      </td>
    </tr>
  </table>

  <h3>公開鍵 (JWK)</h3>
  <pre class="code-block"><%= JSON.stringify({ kty: key.kty, crv: key.crv, x: key.x, y: key.y }, null, 2) %></pre>
</div>

<% if (x509Chain && x509Chain.length > 0) { %>
<div class="detail-card">
  <h3>X.509証明書チェーン</h3>

  <div class="cert-description-section">
    <form action="/admin/keys/<%= key.kid %>/description" method="POST" class="description-form">
      <label>説明:</label>
      <input type="text" name="description" value="<%= certDescription || '' %>" placeholder="証明書の説明を入力">
      <button type="submit" class="btn btn-primary btn-small">保存</button>
    </form>
  </div>

  <% x509Chain.forEach(function(cert, index) { %>
  <div class="cert-item">
    <h4>証明書 <%= index + 1 %><% if (index === 0) { %> (End Entity)<% } else if (index === x509Chain.length - 1) { %> (Root)<% } else { %> (Intermediate)<% } %></h4>

    <% if (certInfos && certInfos[index]) { %>
    <% var info = certInfos[index]; %>
    <table class="detail-table cert-info-table">
      <tr>
        <th>Subject</th>
        <td>
          <% if (info.subject.commonName) { %>CN=<%= info.subject.commonName %><% } %>
          <% if (info.subject.organizationalUnitName) { %>, OU=<%= info.subject.organizationalUnitName %><% } %>
          <% if (info.subject.organizationName) { %>, O=<%= info.subject.organizationName %><% } %>
          <% if (info.subject.countryName) { %>, C=<%= info.subject.countryName %><% } %>
        </td>
      </tr>
      <tr>
        <th>Issuer</th>
        <td>
          <% if (info.issuer.commonName) { %>CN=<%= info.issuer.commonName %><% } %>
          <% if (info.issuer.organizationalUnitName) { %>, OU=<%= info.issuer.organizationalUnitName %><% } %>
          <% if (info.issuer.organizationName) { %>, O=<%= info.issuer.organizationName %><% } %>
          <% if (info.issuer.countryName) { %>, C=<%= info.issuer.countryName %><% } %>
        </td>
      </tr>
      <tr>
        <th>Serial Number</th>
        <td class="serial"><%= info.serialNumber %></td>
      </tr>
      <tr>
        <th>有効期間</th>
        <td>
          <%= new Date(info.notBefore).toLocaleString('ja-JP') %>
          〜
          <%= new Date(info.notAfter).toLocaleString('ja-JP') %>
        </td>
      </tr>
    </table>
    <% } %>

    <details class="cert-pem-details">
      <summary>PEM形式を表示</summary>
      <div class="pem-container">
        <button type="button" class="copy-btn" onclick="copyPem(this)" title="コピー">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
        </button>
        <pre class="code-block pem-content">-----BEGIN CERTIFICATE-----
<%= cert.match(/.{1,64}/g).join('\n') %>
-----END CERTIFICATE-----</pre>
      </div>
    </details>

    <% if (!key.revokedAt) { %>
    <div class="cert-actions">
      <% if (index === 0) { %>
      <a href="/admin/keys/<%= key.kid %>/add-parent-cert" class="btn btn-secondary btn-small">上位証明書を追加</a>
      <% } else { %>
      <form action="/admin/keys/<%= key.kid %>/remove-cert/<%= index %>" method="POST" style="display: inline;" onsubmit="return confirm('この証明書を削除しますか？');">
        <button type="submit" class="btn btn-danger btn-small">この証明書を削除</button>
      </form>
      <% } %>
    </div>
    <% } %>
  </div>
  <% }); %>
</div>
<% } else { %>
<div class="detail-card">
  <h3>X.509証明書</h3>
  <p class="text-muted">証明書は登録されていません。</p>
  <% if (!key.revokedAt) { %>
  <a href="/admin/keys/<%= key.kid %>/certificate" class="btn btn-primary">証明書を発行</a>
  <% } %>
</div>
<% } %>

<div class="toolbar">
  <a href="/admin/keys" class="btn btn-secondary">一覧に戻る</a>
</div>

<style>
.detail-card {
  background: #f8f9fa;
  border-radius: 8px;
  padding: 1.5rem;
  margin-bottom: 1.5rem;
}
.detail-card h3 {
  margin-top: 0;
  border-bottom: 1px solid #dee2e6;
  padding-bottom: 0.5rem;
}
.detail-card h4 {
  margin-top: 1rem;
  font-size: 1rem;
  color: #495057;
}
.detail-table {
  width: 100%;
  border-collapse: collapse;
}
.detail-table th {
  text-align: left;
  width: 150px;
  padding: 0.5rem 0;
  color: #6c757d;
  font-weight: normal;
}
.detail-table td {
  padding: 0.5rem 0;
}
.detail-table td.serial {
  font-family: monospace;
  font-size: 0.85em;
  word-break: break-all;
}
.code-block {
  background: #fff;
  border: 1px solid #dee2e6;
  border-radius: 4px;
  padding: 1rem;
  overflow-x: auto;
  font-size: 0.85em;
  white-space: pre-wrap;
  word-break: break-all;
}
.text-muted {
  color: #6c757d;
}
.badge {
  display: inline-block;
  padding: 0.25em 0.5em;
  font-size: 0.85em;
  border-radius: 0.25em;
}
.badge-success {
  background-color: #28a745;
  color: white;
}
.badge-danger {
  background-color: #dc3545;
  color: white;
}
.btn-danger {
  background-color: #dc3545;
  color: white;
  border-color: #dc3545;
}
.btn-danger:hover {
  background-color: #c82333;
  border-color: #bd2130;
}
.description-form {
  display: flex;
  gap: 0.5rem;
  align-items: center;
}
.description-form input {
  flex: 1;
  padding: 0.375rem 0.5rem;
  border: 1px solid #ced4da;
  border-radius: 4px;
  font-size: 0.9rem;
  max-width: 300px;
}
.description-form input:focus {
  outline: none;
  border-color: #80bdff;
  box-shadow: 0 0 0 0.15rem rgba(0,123,255,.25);
}
.cert-description-section {
  margin-bottom: 1rem;
  padding-bottom: 1rem;
  border-bottom: 1px solid #dee2e6;
}
.cert-description-section label {
  margin-right: 0.5rem;
  font-weight: 500;
}
.cert-item {
  background: #fff;
  border: 1px solid #dee2e6;
  border-radius: 6px;
  padding: 1rem;
  margin-bottom: 1rem;
}
.cert-item h4 {
  margin: 0 0 0.75rem 0;
  font-size: 0.95rem;
  color: #495057;
}
.cert-info-table {
  margin-bottom: 0.75rem;
}
.cert-info-table th {
  width: 120px;
  font-size: 0.85em;
}
.cert-info-table td {
  font-size: 0.85em;
}
.cert-pem-details {
  margin-top: 0.5rem;
}
.cert-pem-details summary {
  cursor: pointer;
  color: #3b82f6;
  font-size: 0.85em;
}
.cert-pem-details summary:hover {
  text-decoration: underline;
}
.cert-pem-details .code-block {
  margin-top: 0.5rem;
}
.cert-actions {
  margin-top: 0.75rem;
  padding-top: 0.75rem;
  border-top: 1px dashed #dee2e6;
}
.pem-container {
  position: relative;
  margin-top: 0.5rem;
}
.copy-btn {
  position: absolute;
  top: 0.5rem;
  right: 0.5rem;
  padding: 0.4rem;
  background: #fff;
  border: 1px solid #dee2e6;
  border-radius: 4px;
  cursor: pointer;
  color: #6c757d;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s;
}
.copy-btn:hover {
  background: #f8f9fa;
  color: #495057;
  border-color: #adb5bd;
}
.copy-btn.copied {
  background: #28a745;
  color: white;
  border-color: #28a745;
}
.pem-content {
  margin: 0;
  padding-right: 3rem;
}
</style>

<script>
function copyPem(button) {
  const container = button.closest('.pem-container');
  const preElement = container.querySelector('.pem-content');
  const text = preElement.textContent;

  navigator.clipboard.writeText(text).then(function() {
    button.classList.add('copied');
    button.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>';

    setTimeout(function() {
      button.classList.remove('copied');
      button.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>';
    }, 2000);
  }).catch(function(err) {
    console.error('Failed to copy:', err);
    alert('コピーに失敗しました');
  });
}
</script>
