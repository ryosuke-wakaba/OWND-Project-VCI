<nav class="breadcrumb">
  <a href="/admin"><%= t('common:breadcrumb.top') %></a> &gt; <a href="/admin/keys"><%= t('keys:breadcrumb.management') %></a> &gt; <a href="/admin/keys/<%= key.kid %>/detail"><%= t('keys:breadcrumb.detail') %></a> &gt; <span><%= t('keys:breadcrumb.addParentCert') %></span>
</nav>

<h2><%= t('keys:addParentCert.title') %></h2>

<div class="info-card">
  <h3><%= t('keys:addParentCert.targetKey') %></h3>
  <table class="detail-table">
    <tr>
      <th><%= t('keys:addParentCert.keyId') %></th>
      <td><%= key.kid %></td>
    </tr>
    <tr>
      <th><%= t('keys:addParentCert.currentChainLength') %></th>
      <td><%= currentChainLength %> <%= t('keys:addParentCert.certificates') %></td>
    </tr>
    <% if (leafCertInfo) { %>
    <tr>
      <th><%= t('keys:addParentCert.leafCertSubject') %></th>
      <td>
        <% if (leafCertInfo.subject.commonName) { %>CN=<%= leafCertInfo.subject.commonName %><% } %>
        <% if (leafCertInfo.subject.organizationName) { %>, O=<%= leafCertInfo.subject.organizationName %><% } %>
      </td>
    </tr>
    <tr>
      <th><%= t('keys:addParentCert.leafCertIssuer') %></th>
      <td>
        <% if (leafCertInfo.issuer.commonName) { %>CN=<%= leafCertInfo.issuer.commonName %><% } %>
        <% if (leafCertInfo.issuer.organizationName) { %>, O=<%= leafCertInfo.issuer.organizationName %><% } %>
      </td>
    </tr>
    <% } %>
  </table>
</div>

<form action="/admin/keys/<%= key.kid %>/add-parent-cert" method="POST" class="form-card">
  <div class="form-group">
    <label for="certificatesPem"><%= t('keys:addParentCert.parentCert') %> <span class="required">*</span></label>
    <textarea id="certificatesPem" name="certificatesPem" required rows="12"
              placeholder="-----BEGIN CERTIFICATE-----
...
-----END CERTIFICATE-----
-----BEGIN CERTIFICATE-----
...
-----END CERTIFICATE-----"></textarea>
    <small class="form-text"><%= t('keys:addParentCert.parentCertHelp') %></small>
  </div>

  <div class="form-actions">
    <a href="/admin/keys/<%= key.kid %>/detail" class="btn btn-secondary"><%= t('common:buttons.cancel') %></a>
    <button type="submit" class="btn btn-primary"><%= t('common:buttons.add') %></button>
  </div>
</form>

<div class="help-card">
  <h3><%= t('common:help.title') %></h3>
  <p><%= t('keys:addParentCert.helpText') %></p>
  <ul>
    <li><strong><%= lng === 'en' ? 'Input Order:' : '入力順序:' %></strong> <%= t('keys:addParentCert.helpOrder') %></li>
    <li><strong><%= lng === 'en' ? 'Format:' : '形式:' %></strong> <%- t('keys:addParentCert.helpFormat') %></li>
    <li><%= t('keys:addParentCert.helpMultiple') %></li>
  </ul>
</div>

<style>
.info-card {
  background: #e7f3ff;
  border: 1px solid #b6d4fe;
  border-radius: 8px;
  padding: 1rem 1.5rem;
  margin-bottom: 1.5rem;
  max-width: 700px;
}
.info-card h3 {
  margin-top: 0;
  font-size: 1rem;
  color: #084298;
}
.detail-table {
  width: 100%;
  border-collapse: collapse;
}
.detail-table th {
  text-align: left;
  width: 180px;
  padding: 0.4rem 0;
  color: #0a58ca;
  font-weight: normal;
  font-size: 0.9em;
}
.detail-table td {
  padding: 0.4rem 0;
  font-size: 0.9em;
}
.form-card {
  background: #f8f9fa;
  border-radius: 8px;
  padding: 1.5rem;
  max-width: 700px;
}
.form-group {
  margin-bottom: 1rem;
}
.form-group label {
  display: block;
  margin-bottom: 0.5rem;
  font-weight: 500;
}
.form-group textarea {
  width: 100%;
  padding: 0.5rem;
  border: 1px solid #ced4da;
  border-radius: 4px;
  font-family: monospace;
  font-size: 0.9rem;
}
.form-group textarea:focus {
  outline: none;
  border-color: #80bdff;
  box-shadow: 0 0 0 0.2rem rgba(0,123,255,.25);
}
.form-text {
  display: block;
  margin-top: 0.25rem;
  font-size: 0.85em;
  color: #6c757d;
}
.required {
  color: #dc3545;
}
.form-actions {
  margin-top: 1.5rem;
  display: flex;
  gap: 0.5rem;
  justify-content: flex-end;
}
.help-card {
  background: #fff3cd;
  border: 1px solid #ffeeba;
  border-radius: 8px;
  padding: 1rem 1.5rem;
  margin-top: 1.5rem;
  max-width: 700px;
}
.help-card h3 {
  margin-top: 0;
  font-size: 1rem;
  color: #856404;
}
.help-card p, .help-card ul {
  margin-bottom: 0.5rem;
  font-size: 0.9rem;
  color: #856404;
}
.help-card code {
  background: rgba(0,0,0,0.1);
  padding: 0.1rem 0.3rem;
  border-radius: 3px;
  font-size: 0.85em;
}
</style>
