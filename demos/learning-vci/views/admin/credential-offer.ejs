<nav class="breadcrumb">
  <a href="/admin">トップ</a> &gt; <a href="/admin/learners">学習者管理</a> &gt; <span>クレデンシャル発行</span>
</nav>

<h2>クレデンシャル発行</h2>

<div class="credential-offer-container">
  <div class="info-section">
    <h3>学習者情報</h3>
    <div class="info-item">
      <label>学習者番号:</label>
      <span><%= subject.learnerNo %></span>
    </div>
  </div>

  <div class="info-section">
    <h3>Credential Offer</h3>
    <div class="qr-code-container">
      <div id="qrcode"></div>
    </div>
    <p class="info-note">このQRコードをウォレットアプリでスキャンしてクレデンシャルを取得してください。</p>
    <div class="url-container">
      <input type="text" id="credentialOfferUrl" value="<%= credentialOffer %>" readonly>
      <button onclick="copyToClipboard()" class="btn btn-secondary btn-small">コピー</button>
    </div>
  </div>

  <div class="info-section">
    <h3>発行情報</h3>
    <div class="info-item">
      <label>TX Code (PIN):</label>
      <span class="tx-code"><%= txCode.match(/.{1,3}/g).join('-') %></span>
    </div>
    <div class="info-item">
      <label>有効期限:</label>
      <div class="expires-container">
        <span class="expires-at"><%= expiresAtJST %> (JST)</span>
        <span class="expires-at-utc"><%= expiresAtUTC %></span>
      </div>
    </div>
    <div class="info-item">
      <label>クライアント認証:</label>
      <% if (requireClientAuth) { %>
      <span class="client-auth-required">必須</span>
      <% } else { %>
      <span class="client-auth-optional">任意</span>
      <% } %>
    </div>
    <p class="info-note">このPINコードは、クレデンシャルを取得する際に必要です。有効期限までにウォレットアプリで取得してください。</p>
    <% if (requireClientAuth) { %>
    <p class="info-note info-note-warning">このCredential Offerでは、WalletはWallet Attestationを提示する必要があります。</p>
    <% } %>
  </div>

  <div class="form-actions">
    <a href="/admin/learners" class="btn btn-secondary">学習者一覧に戻る</a>
  </div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
<script>
// Generate QR Code
const credentialOfferUrl = "<%= credentialOffer %>";
new QRCode(document.getElementById("qrcode"), {
  text: credentialOfferUrl,
  width: 256,
  height: 256,
  colorDark: "#000000",
  colorLight: "#ffffff",
  correctLevel: QRCode.CorrectLevel.H
});

// Copy to clipboard function
function copyToClipboard() {
  const input = document.getElementById('credentialOfferUrl');
  input.select();
  input.setSelectionRange(0, 99999);

  try {
    document.execCommand('copy');
    alert('URLをコピーしました');
  } catch (err) {
    console.error('コピーに失敗しました:', err);
    alert('コピーに失敗しました');
  }
}
</script>

