<nav class="breadcrumb">
  <a href="/admin"><%= t('common:breadcrumb.top') %></a> &gt; <a href="/admin/learners"><%= t('learners:breadcrumb.management') %></a> &gt; <span><%= t('learners:breadcrumb.credentialIssue') %></span>
</nav>

<h2><%= t('learners:offer.title') %></h2>

<div class="info-card">
  <h3><%= t('learners:offer.learnerInfo') %></h3>
  <table class="detail-table">
    <tr>
      <th><%= t('learners:table.learnerNo') %></th>
      <td><%= learner.learnerNo %></td>
    </tr>
    <tr>
      <th><%= t('learners:table.name') %></th>
      <td><%= learner.familyName %> <%= learner.givenName %></td>
    </tr>
    <tr>
      <th><%= t('learners:table.courseTitle') %></th>
      <td><%= learner.achievementTitle %></td>
    </tr>
  </table>
</div>

<form action="/admin/learners/<%= learner.learnerNo %>/offer" method="POST" class="form-card">
  <div class="form-group">
    <label for="signingKeyKid"><%= t('learners:offer.signingKey') %> <span class="required">*</span></label>
    <select id="signingKeyKid" name="signingKeyKid" required>
      <option value=""><%= t('learners:offer.selectSigningKey') %></option>
      <% availableKeys.forEach(function(key) { %>
        <option value="<%= key.kid %>" <%= key.isLatest ? 'selected' : '' %>>
          <%= key.kid %>
          <% if (key.certDescription) { %>- <%= key.certDescription %><% } %>
          (<%= key.crv %>,
          <%= key.hasCertificate ? t('learners:offer.x5cMethod') : t('learners:offer.jwkMethod') %>)
          <% if (key.isLatest) { %>[<%= t('learners:offer.latest') %>]<% } %>
        </option>
      <% }); %>
    </select>
    <small class="form-text">
      <strong><%= t('learners:offer.x5cMethod') %>:</strong> <%= t('learners:offer.x5cDescription') %><br>
      <strong><%= t('learners:offer.jwkMethod') %>:</strong> <%= t('learners:offer.jwkDescription') %>
    </small>
  </div>

  <div class="form-group">
    <label class="checkbox-label">
      <input type="checkbox" name="requireClientAuth" value="true">
      <%= t('learners:offer.requireClientAuth') %>
    </label>
    <small class="form-text">
      <%= t('learners:offer.requireClientAuthHelp') %>
    </small>
  </div>

  <div class="form-group">
    <label class="checkbox-label">
      <input type="checkbox" name="requireDpop" value="true">
      <%= t('learners:offer.requireDpop') %>
    </label>
    <small class="form-text">
      <%= t('learners:offer.requireDpopHelp') %>
    </small>
  </div>

  <% if (availableKeys.length === 0) { %>
  <div class="alert alert-warning">
    <p><%- t('learners:offer.noSigningKeys') %></p>
  </div>
  <% } %>

  <div class="form-actions">
    <a href="/admin/learners" class="btn btn-secondary"><%= t('common:buttons.cancel') %></a>
    <button type="submit" class="btn btn-primary" <%= availableKeys.length === 0 ? 'disabled' : '' %>><%= t('common:buttons.issue') %></button>
  </div>
</form>

<style>
.info-card {
  background: #e7f3ff;
  border: 1px solid #b8daff;
  border-radius: 8px;
  padding: 1.5rem;
  margin-bottom: 1.5rem;
}
.info-card h3 {
  margin-top: 0;
  margin-bottom: 1rem;
  font-size: 1.1rem;
}
.detail-table {
  width: 100%;
  border-collapse: collapse;
}
.detail-table th {
  text-align: left;
  width: 150px;
  padding: 0.5rem 0;
  color: #6c757d;
  font-weight: normal;
}
.detail-table td {
  padding: 0.5rem 0;
}
.form-card {
  background: #f8f9fa;
  border-radius: 8px;
  padding: 1.5rem;
  max-width: 600px;
}
.form-group {
  margin-bottom: 1rem;
}
.form-group label {
  display: block;
  margin-bottom: 0.5rem;
  font-weight: 500;
}
.form-group select {
  width: 100%;
  padding: 0.5rem;
  border: 1px solid #ced4da;
  border-radius: 4px;
  font-size: 1rem;
}
.form-group select:focus {
  outline: none;
  border-color: #80bdff;
  box-shadow: 0 0 0 0.2rem rgba(0,123,255,.25);
}
.form-text {
  display: block;
  margin-top: 0.5rem;
  font-size: 0.85em;
  color: #6c757d;
  line-height: 1.5;
}
.required {
  color: #dc3545;
}
.form-actions {
  margin-top: 1.5rem;
  display: flex;
  gap: 0.5rem;
  justify-content: flex-end;
}
.alert {
  padding: 1rem;
  border-radius: 8px;
  margin-bottom: 1rem;
}
.alert-warning {
  background: #fff3cd;
  border: 1px solid #ffeeba;
  color: #856404;
}
.alert a {
  color: #533f03;
  font-weight: 500;
}
.checkbox-label {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  font-weight: 500;
  cursor: pointer;
}
.checkbox-label input[type="checkbox"] {
  width: 18px;
  height: 18px;
  cursor: pointer;
}
</style>
