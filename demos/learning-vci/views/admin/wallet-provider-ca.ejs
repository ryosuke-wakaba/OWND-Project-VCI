<div class="breadcrumb">
  <a href="/admin"><%= t('common:breadcrumb.adminMenu') %></a> &gt; <span><%= t('wallet:breadcrumb.management') %></span>
</div>

<h2><%= t('wallet:title') %></h2>

<section class="settings-section">
  <h3><%= t('wallet:settings.title') %></h3>
  <form method="POST" action="/admin/wallet-provider-ca/settings">
    <div class="form-group">
      <label class="checkbox-label">
        <input type="checkbox" name="enableChainValidation" value="true" <%= settings.enableChainValidation ? 'checked' : '' %>>
        <%= t('wallet:settings.enableChainValidation') %>
      </label>
      <p class="help-text">
        <%= t('wallet:settings.helpText') %>
      </p>
    </div>
    <button type="submit" class="btn btn-primary"><%= t('wallet:settings.save') %></button>
  </form>
</section>

<section class="ca-list-section">
  <h3><%= t('wallet:caList.title') %></h3>
  <% if (cas.length === 0) { %>
    <p class="empty-message"><%= t('wallet:caList.empty') %></p>
  <% } else { %>
    <table class="data-table">
      <thead>
        <tr>
          <th><%= t('wallet:caList.table.name') %></th>
          <th><%= t('wallet:caList.table.subject') %></th>
          <th><%= t('wallet:caList.table.expiresAt') %></th>
          <th><%= t('wallet:caList.table.status') %></th>
          <th><%= t('wallet:caList.table.registeredAt') %></th>
          <th><%= t('wallet:caList.table.operation') %></th>
        </tr>
      </thead>
      <tbody>
        <% cas.forEach(ca => { %>
          <tr class="<%= !ca.enabled ? 'disabled-row' : '' %>">
            <td><%= ca.name %></td>
            <td>
              <% if (ca.certInfo) { %>
                <code class="subject"><%= ca.certInfo.subject %></code>
              <% } else { %>
                <span class="text-muted">-</span>
              <% } %>
            </td>
            <td>
              <% if (ca.certInfo) { %>
                <%= new Date(ca.certInfo.notAfter).toLocaleDateString(lng === 'en' ? 'en-US' : 'ja-JP') %>
              <% } else { %>
                <span class="text-muted">-</span>
              <% } %>
            </td>
            <td>
              <% if (ca.enabled) { %>
                <span class="status-badge status-active"><%= t('wallet:caList.status.active') %></span>
              <% } else { %>
                <span class="status-badge status-inactive"><%= t('wallet:caList.status.inactive') %></span>
              <% } %>
            </td>
            <td><%= new Date(ca.createdAt).toLocaleDateString(lng === 'en' ? 'en-US' : 'ja-JP') %></td>
            <td class="actions">
              <form method="POST" action="/admin/wallet-provider-ca/<%= ca.id %>/toggle" style="display:inline;">
                <button type="submit" class="btn btn-sm <%= ca.enabled ? 'btn-warning' : 'btn-success' %>">
                  <%= ca.enabled ? t('wallet:caList.actions.disable') : t('wallet:caList.actions.enable') %>
                </button>
              </form>
              <form method="POST" action="/admin/wallet-provider-ca/<%= ca.id %>/delete" style="display:inline;" onsubmit="return confirm('<%= t('wallet:caList.confirmDelete') %>');">
                <button type="submit" class="btn btn-sm btn-danger"><%= t('wallet:caList.actions.delete') %></button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>
</section>

<section class="import-section">
  <h3><%= t('wallet:import.title') %></h3>
  <form method="POST" action="/admin/wallet-provider-ca/import">
    <div class="form-group">
      <label for="name"><%= t('wallet:import.caName') %> <span class="required">*</span></label>
      <input type="text" id="name" name="name" required placeholder="<%= t('wallet:import.caNamePlaceholder') %>">
    </div>
    <div class="form-group">
      <label for="rootCertPem"><%= t('wallet:import.rootCert') %> <span class="required">*</span></label>
      <textarea id="rootCertPem" name="rootCertPem" rows="12" required placeholder="-----BEGIN CERTIFICATE-----
MIIBxxxxxxxxxxxxxxxx...
-----END CERTIFICATE-----"></textarea>
      <p class="help-text">
        <%= t('wallet:import.rootCertHelp') %>
      </p>
    </div>
    <button type="submit" class="btn btn-primary"><%= t('wallet:import.submit') %></button>
  </form>
</section>

<style>
  .settings-section,
  .ca-list-section,
  .import-section {
    background: #fff;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    padding: 1.5rem;
    margin-bottom: 1.5rem;
  }

  .settings-section h3,
  .ca-list-section h3,
  .import-section h3 {
    margin-top: 0;
    margin-bottom: 1rem;
    color: #1e293b;
    border-bottom: 1px solid #e2e8f0;
    padding-bottom: 0.5rem;
  }

  .checkbox-label {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    cursor: pointer;
  }

  .checkbox-label input[type="checkbox"] {
    width: 18px;
    height: 18px;
  }

  .help-text {
    color: #64748b;
    font-size: 0.875rem;
    margin-top: 0.5rem;
  }

  .empty-message {
    color: #64748b;
    font-style: italic;
  }

  .data-table {
    width: 100%;
    border-collapse: collapse;
  }

  .data-table th,
  .data-table td {
    padding: 0.75rem;
    text-align: left;
    border-bottom: 1px solid #e2e8f0;
  }

  .data-table th {
    background: #f8fafc;
    font-weight: 600;
    color: #475569;
  }

  .data-table .disabled-row {
    opacity: 0.6;
  }

  .subject {
    font-size: 0.8rem;
    background: #f1f5f9;
    padding: 0.25rem 0.5rem;
    border-radius: 4px;
    display: inline-block;
    max-width: 300px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .status-badge {
    display: inline-block;
    padding: 0.25rem 0.5rem;
    border-radius: 4px;
    font-size: 0.75rem;
    font-weight: 600;
  }

  .status-active {
    background: #dcfce7;
    color: #166534;
  }

  .status-inactive {
    background: #fef2f2;
    color: #991b1b;
  }

  .actions {
    white-space: nowrap;
  }

  .btn-sm {
    padding: 0.25rem 0.5rem;
    font-size: 0.75rem;
  }

  .btn-warning {
    background: #f59e0b;
    color: #fff;
    border: none;
  }

  .btn-warning:hover {
    background: #d97706;
  }

  .btn-success {
    background: #10b981;
    color: #fff;
    border: none;
  }

  .btn-success:hover {
    background: #059669;
  }

  .btn-danger {
    background: #ef4444;
    color: #fff;
    border: none;
  }

  .btn-danger:hover {
    background: #dc2626;
  }

  .form-group {
    margin-bottom: 1rem;
  }

  .form-group label {
    display: block;
    margin-bottom: 0.5rem;
    font-weight: 500;
    color: #374151;
  }

  .form-group input[type="text"],
  .form-group textarea {
    width: 100%;
    padding: 0.5rem;
    border: 1px solid #d1d5db;
    border-radius: 4px;
    font-size: 1rem;
  }

  .form-group textarea {
    font-family: monospace;
    font-size: 0.875rem;
  }

  .required {
    color: #ef4444;
  }

  .text-muted {
    color: #9ca3af;
  }
</style>
