<nav class="breadcrumb">
  <a href="/admin"><%= t('common:breadcrumb.top') %></a> &gt; <a href="/admin/keys"><%= t('keys:breadcrumb.management') %></a> &gt; <span><%= t('keys:breadcrumb.import') %></span>
</nav>

<h2><%= t('keys:import.title') %></h2>

<form action="/admin/keys/import" method="POST" class="form-card">
  <div class="form-group">
    <label for="kid"><%= t('keys:form.keyId') %> <span class="required">*</span></label>
    <input type="text" id="kid" name="kid" required placeholder="<%= t('keys:form.keyIdPlaceholder').replace('issuer-key-1', 'imported-key-1') %>">
    <small class="form-text"><%= t('keys:form.keyIdHelp') %></small>
  </div>

  <div class="form-group">
    <label for="privateKeyPem"><%= t('keys:form.privateKey') %> <span class="required">*</span></label>
    <textarea id="privateKeyPem" name="privateKeyPem" required rows="8"
              placeholder="-----BEGIN EC PRIVATE KEY-----
...
-----END EC PRIVATE KEY-----"></textarea>
    <small class="form-text"><%= t('keys:form.privateKeyHelp') %></small>
  </div>

  <div class="form-group">
    <label for="certificatesPem"><%= t('keys:form.certificateChain') %></label>
    <textarea id="certificatesPem" name="certificatesPem" rows="10"
              placeholder="-----BEGIN CERTIFICATE-----
...
-----END CERTIFICATE-----
-----BEGIN CERTIFICATE-----
...
-----END CERTIFICATE-----"></textarea>
    <small class="form-text"><%= t('keys:form.certificateChainHelp') %></small>
  </div>

  <div class="form-group">
    <label for="certDescription"><%= t('keys:form.certDescription') %></label>
    <input type="text" id="certDescription" name="certDescription" placeholder="<%= t('keys:form.certDescriptionPlaceholder') %>">
    <small class="form-text"><%= t('keys:form.certDescriptionHelp') %></small>
  </div>

  <div class="form-actions">
    <a href="/admin/keys" class="btn btn-secondary"><%= t('common:buttons.cancel') %></a>
    <button type="submit" class="btn btn-primary"><%= t('common:buttons.import') %></button>
  </div>
</form>

<div class="help-card">
  <h3><%= t('common:help.title') %></h3>
  <p><%= t('keys:importHelp.text') %></p>
  <ul>
    <li><strong><%= t('keys:form.privateKey').replace(' *', '') %>:</strong> <%- t('keys:importHelp.privateKey') %></li>
    <li><strong><%= t('keys:form.curve') %>:</strong> <%= t('keys:importHelp.supportedCurves') %></li>
    <li><strong><%= t('keys:table.certificate') %>:</strong> <%= t('keys:importHelp.certificate') %></li>
  </ul>
</div>

<style>
.form-card {
  background: #f8f9fa;
  border-radius: 8px;
  padding: 1.5rem;
  max-width: 700px;
}
.form-group {
  margin-bottom: 1rem;
}
.form-group label {
  display: block;
  margin-bottom: 0.5rem;
  font-weight: 500;
}
.form-group input,
.form-group textarea {
  width: 100%;
  padding: 0.5rem;
  border: 1px solid #ced4da;
  border-radius: 4px;
  font-size: 1rem;
  font-family: inherit;
}
.form-group textarea {
  font-family: monospace;
  font-size: 0.9rem;
}
.form-group input:focus,
.form-group textarea:focus {
  outline: none;
  border-color: #80bdff;
  box-shadow: 0 0 0 0.2rem rgba(0,123,255,.25);
}
.form-text {
  display: block;
  margin-top: 0.25rem;
  font-size: 0.85em;
  color: #6c757d;
}
.required {
  color: #dc3545;
}
.form-actions {
  margin-top: 1.5rem;
  display: flex;
  gap: 0.5rem;
  justify-content: flex-end;
}
.help-card {
  background: #fff3cd;
  border: 1px solid #ffeeba;
  border-radius: 8px;
  padding: 1rem 1.5rem;
  margin-top: 1.5rem;
  max-width: 700px;
}
.help-card h3 {
  margin-top: 0;
  font-size: 1rem;
  color: #856404;
}
.help-card p, .help-card ul {
  margin-bottom: 0.5rem;
  font-size: 0.9rem;
  color: #856404;
}
.help-card code {
  background: rgba(0,0,0,0.1);
  padding: 0.1rem 0.3rem;
  border-radius: 3px;
  font-size: 0.85em;
}
</style>
