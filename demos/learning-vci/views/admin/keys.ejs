<nav class="breadcrumb">
  <a href="/admin"><%= t('common:breadcrumb.top') %></a> &gt; <span><%= t('keys:breadcrumb.management') %></span>
</nav>

<h2><%= t('keys:title') %></h2>

<div class="toolbar">
  <div></div>
  <div class="actions">
    <a href="/admin/keys/new" class="btn btn-primary"><%= t('keys:new.button') %></a>
    <a href="/admin/keys/import" class="btn btn-secondary"><%= t('keys:import.button') %></a>
  </div>
</div>

<% if (keys && keys.length > 0) { %>
  <table>
    <thead>
      <tr>
        <th><%= t('keys:table.keyId') %></th>
        <th><%= t('keys:table.curve') %></th>
        <th><%= t('keys:table.certificate') %></th>
        <th><%= t('keys:table.description') %></th>
        <th><%= t('keys:table.createdAt') %></th>
        <th><%= t('common:labels.actions') %></th>
      </tr>
    </thead>
    <tbody>
      <% keys.forEach(function(key) { %>
        <tr>
          <td><%= key.kid %></td>
          <td><%= key.crv %></td>
          <td>
            <% if (key.hasCertificate) { %>
              <span class="badge badge-success"><%= t('common:labels.yes') %></span>
            <% } else { %>
              <span class="badge badge-warning"><%= t('common:labels.no') %></span>
            <% } %>
          </td>
          <td><%= key.certDescription || '-' %></td>
          <td><%= new Date(key.createdAt).toLocaleString(lng === 'en' ? 'en-US' : 'ja-JP') %></td>
          <td>
            <div class="actions">
              <a href="/admin/keys/<%= key.kid %>/detail" class="btn btn-secondary btn-small"><%= t('common:buttons.details') %></a>
              <% if (!key.hasCertificate) { %>
                <a href="/admin/keys/<%= key.kid %>/certificate" class="btn btn-primary btn-small"><%= t('keys:detail.issueCertificate') %></a>
              <% } %>
            </div>
          </td>
        </tr>
      <% }); %>
    </tbody>
  </table>
<% } else { %>
  <div class="empty-state">
    <p><%= t('keys:empty.message') %></p>
    <a href="/admin/keys/new" class="btn btn-primary"><%= t('keys:empty.action') %></a>
  </div>
<% } %>

<style>
.badge {
  display: inline-block;
  padding: 0.25em 0.5em;
  font-size: 0.85em;
  border-radius: 0.25em;
}
.badge-success {
  background-color: #28a745;
  color: white;
}
.badge-warning {
  background-color: #ffc107;
  color: black;
}
.badge-danger {
  background-color: #dc3545;
  color: white;
}
</style>
