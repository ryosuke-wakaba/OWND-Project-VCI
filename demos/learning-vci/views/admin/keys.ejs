<nav class="breadcrumb">
  <a href="/admin">トップ</a> &gt; <span>キーペア管理</span>
</nav>

<h2>キーペア一覧</h2>

<div class="toolbar">
  <div></div>
  <div class="actions">
    <a href="/admin/keys/new" class="btn btn-primary">新規生成</a>
    <a href="/admin/keys/import" class="btn btn-secondary">インポート</a>
  </div>
</div>

<% if (keys && keys.length > 0) { %>
  <table>
    <thead>
      <tr>
        <th>キーID</th>
        <th>楕円曲線</th>
        <th>証明書</th>
        <th>説明</th>
        <th>作成日</th>
        <th>アクション</th>
      </tr>
    </thead>
    <tbody>
      <% keys.forEach(function(key) { %>
        <tr>
          <td><%= key.kid %></td>
          <td><%= key.crv %></td>
          <td>
            <% if (key.hasCertificate) { %>
              <span class="badge badge-success">あり</span>
            <% } else { %>
              <span class="badge badge-warning">なし</span>
            <% } %>
          </td>
          <td><%= key.certDescription || '-' %></td>
          <td><%= new Date(key.createdAt).toLocaleString('ja-JP') %></td>
          <td>
            <div class="actions">
              <a href="/admin/keys/<%= key.kid %>/detail" class="btn btn-secondary btn-small">詳細</a>
              <% if (!key.hasCertificate) { %>
                <a href="/admin/keys/<%= key.kid %>/certificate" class="btn btn-primary btn-small">証明書発行</a>
              <% } %>
            </div>
          </td>
        </tr>
      <% }); %>
    </tbody>
  </table>
<% } else { %>
  <div class="empty-state">
    <p>登録されているキーペアがありません</p>
    <a href="/admin/keys/new" class="btn btn-primary">最初のキーペアを生成</a>
  </div>
<% } %>

<style>
.badge {
  display: inline-block;
  padding: 0.25em 0.5em;
  font-size: 0.85em;
  border-radius: 0.25em;
}
.badge-success {
  background-color: #28a745;
  color: white;
}
.badge-warning {
  background-color: #ffc107;
  color: black;
}
.badge-danger {
  background-color: #dc3545;
  color: white;
}
</style>
