<nav class="breadcrumb">
  <a href="/admin"><%= t('common:breadcrumb.top') %></a> &gt; <span><%= t('learners:breadcrumb.management') %></span>
</nav>

<h2><%= t('learners:title') %></h2>

<div class="toolbar">
  <div></div>
  <a href="/admin/learners/new" class="btn btn-primary"><%= t('common:buttons.new') %></a>
</div>

<% if (learners && learners.length > 0) { %>
  <table>
    <thead>
      <tr>
        <th><%= t('learners:table.learnerNo') %></th>
        <th><%= t('learners:table.name') %></th>
        <th><%= t('learners:table.courseTitle') %></th>
        <th><%= t('learners:table.issuingAuthority') %></th>
        <th><%= t('learners:table.issuanceDate') %></th>
        <th><%= t('common:labels.actions') %></th>
      </tr>
    </thead>
    <tbody>
      <% learners.forEach(function(learner) { %>
        <tr>
          <td><%= learner.learnerNo %></td>
          <td><%= learner.familyName %> <%= learner.givenName %></td>
          <td><%= learner.achievementTitle %></td>
          <td><%= learner.issuingAuthority %></td>
          <td><%= learner.dateOfIssuance %></td>
          <td>
            <div class="actions">
              <a href="/admin/learners/<%= learner.learnerNo %>/offer" class="btn btn-primary btn-small"><%= t('common:buttons.issue') %></a>
              <a href="/admin/learners/<%= learner.id %>/edit" class="btn btn-secondary btn-small"><%= t('common:buttons.edit') %></a>
              <button onclick="deleteLearner(<%= learner.id %>)" class="btn btn-danger btn-small"><%= t('common:buttons.delete') %></button>
            </div>
          </td>
        </tr>
      <% }); %>
    </tbody>
  </table>
<% } else { %>
  <div class="empty-state">
    <p><%= t('learners:empty.message') %></p>
    <a href="/admin/learners/new" class="btn btn-primary"><%= t('learners:empty.action') %></a>
  </div>
<% } %>

<script>
async function deleteLearner(id) {
  if (!confirm('<%= t('learners:confirm.delete') %>')) {
    return;
  }

  try {
    const response = await fetch(`/admin/learners/${id}`, {
      method: 'DELETE',
      credentials: 'include'
    });

    if (response.ok) {
      location.reload();
    } else {
      alert('<%= t('common:alert.deleteFailed') %>');
    }
  } catch (err) {
    console.error(err);
    alert('<%= t('common:alert.deleteFailed') %>');
  }
}
</script>
