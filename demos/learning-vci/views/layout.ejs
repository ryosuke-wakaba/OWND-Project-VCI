<!DOCTYPE html>
<html lang="<%= lng %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> - Learning VCI</title>
  <link rel="stylesheet" href="/styles/admin.css?v=3">
  <style>
    .breadcrumb {
      margin-bottom: 1rem;
      padding: 0.5rem 0;
      font-size: 0.9rem;
      color: #64748b;
    }
    .breadcrumb a {
      color: #3b82f6;
      text-decoration: none;
    }
    .breadcrumb a:hover {
      text-decoration: underline;
    }
    .breadcrumb span {
      color: #1e293b;
    }
  </style>
</head>
<body>
  <header>
    <div class="container">
      <h1><a href="/admin" style="color: inherit; text-decoration: none;"><%= t('common:title') %></a></h1>
      <nav>
        <a href="/admin"><%= t('common:nav.top') %></a>
        <a href="/admin/learners"><%= t('common:nav.learners') %></a>
        <a href="/admin/keys"><%= t('common:nav.keys') %></a>
        <a href="/admin/metadata"><%= t('common:nav.metadata') %></a>
        <a href="/admin/wallet-provider-ca"><%= t('common:nav.walletProviderCA') %></a>
      </nav>
    </div>
  </header>
  <main class="container">
    <%- body %>
  </main>
  <footer>
    <div class="container">
      <p><%- t('common:footer.copyright') %></p>
    </div>
  </footer>
</body>
</html>
